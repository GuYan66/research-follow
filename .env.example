# 复制本文件为 .env 用于本地运行（run_daily.py 会自动加载）。

# Semantic Scholar：填 API key 可提高速率上限（不填也能用）。
#   申请：https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# OpenAlex：填一个联系邮箱，帮助 OpenAlex 统计流量（礼貌访问，不填则用占位邮箱）。
OPENALEX_MAILTO=your_email@example.com

# 中文简介（可选）。不填则新抓到的条目只显示原文摘要。
# 与 paper-monitor 同一套网关即可。
# LLM_API_KEY=
# LLM_BASE_URL=https://ai-api.d-robotics.cc/v1
# LLM_MODEL=glm-5.2
